<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Singular forms of the English strings that contain a count. Every other English string is the key itself. -->
<plist version="1.0">
<dict>
    <key>%lld tracks · %@</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@tracks@ · %2$@</string>
        <key>tracks</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%1$lld track</string>
            <key>other</key><string>%1$lld tracks</string>
        </dict>
    </dict>
    <key>%lld tracks (%lld exported) · %@</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%1$#@tracks@ (%2$lld exported) · %3$@</string>
        <key>tracks</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%1$lld track</string>
            <key>other</key><string>%1$lld tracks</string>
        </dict>
    </dict>
    <key>Results in %lld tracks. The current split points are replaced.</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>Results in %#@tracks@. The current split points are replaced.</string>
        <key>tracks</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld track</string>
            <key>other</key><string>%lld tracks</string>
        </dict>
    </dict>
    <key>Exports %lld tracks as files named “01 Title”, tagged with the title, track number and album info</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@message@</string>
        <key>message</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>Exports %lld track as a file named “01 Title”, tagged with the title, track number and album info</string>
            <key>other</key><string>Exports %lld tracks as files named “01 Title”, tagged with the title, track number and album info</string>
        </dict>
    </dict>
    <key>Applies fades to %lld tracks. They are re-encoded even when AAC is otherwise cut as is</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@message@</string>
        <key>message</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>Applies fades to %lld track. It is re-encoded even when AAC is otherwise cut as is</string>
            <key>other</key><string>Applies fades to %lld tracks. They are re-encoded even when AAC is otherwise cut as is</string>
        </dict>
    </dict>
    <key>Exported %lld files</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>Exported %#@files@</string>
        <key>files</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld file</string>
            <key>other</key><string>%lld files</string>
        </dict>
    </dict>
    <key>%lld files already exist. Do you want to replace them?</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key><string>%#@message@</string>
        <key>message</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key><string>lld</string>
            <key>one</key><string>%lld file already exists. Do you want to replace it?</string>
            <key>other</key><string>%lld files already exist. Do you want to replace them?</string>
        </dict>
    </dict>
</dict>
</plist>
